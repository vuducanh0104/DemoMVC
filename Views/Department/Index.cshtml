@model IEnumerable<DemoMVC.Models.Department>

@{
    ViewData["Title"] = "Danh sách khoa";
}

<h1>Danh sách khoa</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p>
    <button type="button" class="btn btn-primary" data-crud-modal
            data-url="@Url.Action("Create")">Thêm khoa</button>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã khoa</th>
            <th>Tên khoa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.DepartmentCode</td>
                <td>@department.Name</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-crud-modal
                            data-url="@Url.Action("Edit", new { id = department.DepartmentCode })">Sửa</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-crud-modal
                            data-url="@Url.Action("Delete", new { id = department.DepartmentCode })">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="crudModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="crudModalContent"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
