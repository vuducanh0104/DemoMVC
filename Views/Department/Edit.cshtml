@model DemoMVC.Models.Department

@{
    ViewData["Title"] = "Sửa thông tin khoa";
}

<h1>Sửa thông tin khoa</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.DepartmentCode" method="post">
            <input asp-for="DepartmentCode" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DepartmentCode" class="form-label">Mã khoa</label>
                <input value="@Model.DepartmentCode" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên khoa</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
