@model DemoMVC.ViewModels.PaginationViewModel

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mt-3">
    @if (Model.TotalCount == 0)
    {
        <small class="text-muted">Tổng 0 bản ghi · Tổng số trang: 0</small>
    }
    else
    {
        var firstItem = (Model.PageNumber - 1) * Model.PageSize + 1;
        var lastItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
        <small class="text-muted">
            Hiển thị @firstItem–@lastItem / @Model.TotalCount bản ghi
            · Trang @Model.PageNumber / @Model.TotalPages
        </small>
    }

    @if (Model.TotalPages > 0)
    {
        <nav aria-label="Điều hướng trang">
            <ul class="pagination pagination-sm flex-wrap justify-content-center mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                           asp-route-pageSize="@Model.PageSize" asp-route-pageNumber="1">Trang đầu</a>
                    }
                    else
                    {
                        <span class="page-link" aria-disabled="true">Trang đầu</span>
                    }
                </li>
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                           asp-route-pageSize="@Model.PageSize" asp-route-pageNumber="@(Model.PageNumber - 1)">Trang trước</a>
                    }
                    else
                    {
                        <span class="page-link" aria-disabled="true">Trang trước</span>
                    }
                </li>

                @for (var pageNumber = Model.FirstVisiblePage; pageNumber <= Model.LastVisiblePage; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                           asp-route-pageSize="@Model.PageSize" asp-route-pageNumber="@pageNumber"
                           aria-current="@(pageNumber == Model.PageNumber ? "page" : null)">@pageNumber</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                           asp-route-pageSize="@Model.PageSize" asp-route-pageNumber="@(Model.PageNumber + 1)">Trang tiếp theo</a>
                    }
                    else
                    {
                        <span class="page-link" aria-disabled="true">Trang tiếp theo</span>
                    }
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                           asp-route-pageSize="@Model.PageSize" asp-route-pageNumber="@Model.TotalPages">Trang cuối</a>
                    }
                    else
                    {
                        <span class="page-link" aria-disabled="true">Trang cuối</span>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
